diff --git a/src/libs/whereami/whereami.c b/src/libs/whereami/whereami.c
index 97f7f85..4b73cca 100644
--- a/src/libs/whereami/whereami.c
+++ b/src/libs/whereami/whereami.c
@@ -793,6 +793,50 @@ int WAI_PREFIX(getModulePath)(char* out, int capacity, int* dirname_length)
   return length;
 }
 
+#elif defined(__baseos__)
+
+#include <string.h>
+#include <sys/auxv.h>
+
+/* BaseOS starts programs with their path as argv[0] and AT_EXECFN. */
+static int WAI_PREFIX(getPath)(char* out, int capacity, int* dirname_length)
+{
+  const char* path = (const char*)getauxval(AT_EXECFN);
+  int length, i;
+
+  if (!path || path[0] != '/')
+    return -1;
+  length = (int)strlen(path);
+  if (out && length <= capacity)
+  {
+    memcpy(out, path, length);
+    if (dirname_length)
+    {
+      for (i = length - 1; i >= 0; --i)
+      {
+        if (out[i] == '/')
+        {
+          *dirname_length = i;
+          break;
+        }
+      }
+    }
+  }
+  return length;
+}
+
+WAI_FUNCSPEC
+int WAI_PREFIX(getExecutablePath)(char* out, int capacity, int* dirname_length)
+{
+  return WAI_PREFIX(getPath)(out, capacity, dirname_length);
+}
+
+WAI_FUNCSPEC
+int WAI_PREFIX(getModulePath)(char* out, int capacity, int* dirname_length)
+{
+  return WAI_PREFIX(getPath)(out, capacity, dirname_length);
+}
+
 #else
 
 #error unsupported platform
