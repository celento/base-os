--- a/gcc/config/baseos.h
+++ b/gcc/config/baseos.h
@@ -0,0 +1,52 @@
+/* Target definitions for BaseOS on i686: static ELF32 programs over mlibc.
+   Programs load in the per-process user window that starts at 1 GiB. */
+
+#undef TARGET_OS_CPP_BUILTINS
+#define TARGET_OS_CPP_BUILTINS()          \
+  do {                                    \
+    builtin_define ("__baseos__");        \
+    builtin_define ("__unix__");          \
+    builtin_assert ("system=baseos");     \
+    builtin_assert ("system=unix");       \
+    builtin_assert ("system=posix");      \
+    if (c_dialect_cxx ())                 \
+      builtin_define ("_GNU_SOURCE");     \
+  } while (0)
+
+/* C++ static destructors go through __cxa_atexit; crtbegin.o then
+   defines __dso_handle, which the C library references. */
+#undef DEFAULT_USE_CXA_ATEXIT
+#define DEFAULT_USE_CXA_ATEXIT 1
+
+#undef STARTFILE_SPEC
+#define STARTFILE_SPEC "crt1.o%s crti.o%s crtbegin.o%s"
+
+#undef ENDFILE_SPEC
+#define ENDFILE_SPEC "crtend.o%s crtn.o%s"
+
+#undef LIB_SPEC
+#define LIB_SPEC "%{pthread:} -lc"
+
+/* Static executables only (-rdynamic has nothing to export); the text segment
+   starts inside the user window. */
+#undef LINK_SPEC
+#define LINK_SPEC "-static %{rdynamic:} %{!Ttext-segment*:-Ttext-segment=0x40100000} -z max-page-size=4096"
+
+#undef LINK_GCC_C_SEQUENCE_SPEC
+#define LINK_GCC_C_SEQUENCE_SPEC "--start-group %G %L --end-group"
+
+#undef CPP_SPEC
+#define CPP_SPEC "%{pthread:-D_REENTRANT}"
+
+/* mlibc keeps thread pointers in %gs, like other i386 Unix systems. */
+#undef TARGET_THREAD_SSP_OFFSET
+#define TARGET_THREAD_SSP_OFFSET 0x14
+
+#undef SIZE_TYPE
+#define SIZE_TYPE "unsigned int"
+#undef PTRDIFF_TYPE
+#define PTRDIFF_TYPE "int"
+#undef WCHAR_TYPE
+#define WCHAR_TYPE "int"
+#undef WCHAR_TYPE_SIZE
+#define WCHAR_TYPE_SIZE 32
